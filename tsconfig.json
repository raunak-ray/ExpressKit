{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "declarationMap": true,
    "composite": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./*.ts"],
    },
  },
  "include": ["src", "templates"],
  "exclude": ["node_modules", "dist"],
}
