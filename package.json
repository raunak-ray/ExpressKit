{
  "name": "express-project-init",
  "version": "1.0.0",
  "description": "Create production-ready Express.js API projects with JavaScript or TypeScript using clean, reusable starter templates.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "express-project-init": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','tsconfig.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run clean && npm run build",
    "start": "node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raunak-ray/ExpressKit.git"
  },
  "homepage": "https://github.com/raunak-ray/ExpressKit#readme",
  "bugs": {
    "url": "https://github.com/raunak-ray/ExpressKit/issues"
  },
  "keywords": [
    "express",
    "expressjs",
    "express-generator",
    "express-cli",
    "nodejs",
    "api-generator",
    "backend",
    "project-scaffolding",
    "boilerplate",
    "starter-template",
    "typescript",
    "javascript"
  ],
  "author": "Raunak Ray",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
